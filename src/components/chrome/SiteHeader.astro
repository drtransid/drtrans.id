---
import { getCollection } from 'astro:content';
import ThemeToggle from '@/components/chrome/ThemeToggle.astro';
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { navigation, siteConfig } from '@/config/site';

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : href !== '/' && path.startsWith(href) ? 'true' : undefined);

const workEntries = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const stasiunEntries = workEntries.filter((entry) => entry.data.targetLocation.toLowerCase().includes('stasiun'));
const terminalEntries = workEntries.filter((entry) => entry.data.targetLocation.toLowerCase().includes('terminal'));
---

<header class="site-header sticky top-0 z-40 h-(--header-h) border-b border-transparent bg-canvas">
  <div class="shell relative flex h-full items-center gap-4">
    <a href="/" class="flex items-center gap-2.5 rounded-lg text-[1.15rem] font-semibold tracking-[-0.03em]">
      <Logomark />
      <span>{siteConfig.name}</span>
      <span class="sr-only">, beranda</span>
    </a>

    <nav aria-label="Main" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {navigation.map((link) =>
          link.href === '/work/' ? (
            <li class="mega-item relative" data-mega-root>
              <button
                type="button"
                class="nav-link gap-1.5"
                aria-expanded="false"
                aria-controls="area-mega-menu"
                aria-current={current('/work/')}
                data-mega-trigger
              >
                <span>{link.label}</span>
                <Icon name="chevron-down" class="mega-chevron size-3.5 text-muted" />
              </button>

              <div
                id="area-mega-menu"
                role="region"
                aria-label="Menu Area Stasiun dan Terminal Madiun"
                hidden
                class="mega-panel absolute top-full right-0 z-50 mt-2 rounded-panel border border-line bg-surface p-4 shadow-card"
                data-mega-panel
              >
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="px-2.5 text-[0.7rem] font-semibold tracking-wider text-muted uppercase">
                      Stasiun Madiun
                    </p>
                    <ul class="mt-1.5 grid gap-0.5">
                      {stasiunEntries.map((entry) => {
                        const isMotor = entry.data.category.toLowerCase().includes('roda dua');
                        return (
                          <li>
                            <a
                              href={`/work/${entry.id}/`}
                              class="flex items-center justify-between gap-2 rounded-lg px-2.5 py-2 text-sm transition-colors hover:bg-sunken"
                            >
                              <span class="font-medium text-ink">
                                {isMotor ? 'Sewa Motor' : 'Sewa Mobil'}
                              </span>
                              <span class="text-xs text-muted">{isMotor ? 'Mulai 75K' : 'Driver / Lepas'}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>

                  <div>
                    <p class="px-2.5 text-[0.7rem] font-semibold tracking-wider text-muted uppercase">
                      Terminal Purboyo
                    </p>
                    <ul class="mt-1.5 grid gap-0.5">
                      {terminalEntries.map((entry) => {
                        const isMotor = entry.data.category.toLowerCase().includes('roda dua');
                        return (
                          <li>
                            <a
                              href={`/work/${entry.id}/`}
                              class="flex items-center justify-between gap-2 rounded-lg px-2.5 py-2 text-sm transition-colors hover:bg-sunken"
                            >
                              <span class="font-medium text-ink">
                                {isMotor ? 'Sewa Motor' : 'Mobil & Hiace'}
                              </span>
                              <span class="text-xs text-muted">{isMotor ? 'Mulai 75K' : 'Rombongan'}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </div>

                <div class="mt-3 flex items-center justify-between border-t border-line px-2.5 pt-3 text-xs">
                  <span class="text-muted">Kami antar sampai lokasi</span>
                  <a href="/work/" class="inline-flex items-center gap-1 font-semibold text-ink hover:text-accent-ink">
                    Semua panduan
                    <Icon name="arrow-right" class="size-3.5" />
                  </a>
                </div>
              </div>
            </li>
          ) : (
            <li>
              <a href={link.href} class="nav-link" aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5 md:ml-2">
      <button
        type="button"
        class="btn btn-ghost btn-sm hidden"
        data-pwa-install
        aria-label="Install aplikasi DRTRANS"
      >
        <Icon name="download" class="size-3.5" />
        <span class="hidden lg:inline">Install</span>
      </button>
      <ThemeToggle />
      <a
        class="btn btn-accent btn-sm ml-1 hidden sm:inline-flex"
        href={siteConfig.action.href}
        target="_blank"
        rel="noopener"
      >
        <Icon name="social-whatsapp" class="size-3.5" />
        {siteConfig.action.label}
      </a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full hover:bg-sunken md:hidden"
        commandfor="mobile-nav"
        command="show-modal"
        aria-haspopup="dialog"
        aria-label="Menu"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <dialog id="mobile-nav" aria-label="Menu" class="mobile-nav md:hidden">
    <div class="shell flex h-(--header-h) items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 text-[1.15rem] font-semibold tracking-[-0.03em]">
        <Logomark />
        <span>{siteConfig.name}</span>
        <span class="sr-only">, beranda</span>
      </a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full hover:bg-sunken"
        commandfor="mobile-nav"
        command="close"
        aria-label="Close menu"
      >
        <Icon name="x" class="size-5" />
      </button>
    </div>
    <nav aria-label="Mobile" class="shell mt-4">
      <ul class="grid">
        <li>
          <a href="/" class="mobile-link" aria-current={path === '/' ? 'page' : undefined}>
            Beranda
          </a>
        </li>
        {navigation.map((link) =>
          link.href === '/work/' ? (
            <li class="border-b border-line">
              <details class="mobile-area-group">
                <summary class="mobile-link cursor-pointer list-none justify-between border-b-0">
                  <span>{link.label}</span>
                  <Icon name="chevron-down" class="mobile-area-chevron size-5 text-muted" />
                </summary>
                <div class="grid gap-2 pb-4 pl-2">
                  <a href="/work/" class="rounded-lg px-3 py-2 text-sm font-semibold text-accent-ink hover:bg-sunken">
                    Semua Panduan Area &rarr;
                  </a>
                  {workEntries.map((entry) => (
                    <a
                      href={`/work/${entry.id}/`}
                      class="rounded-lg px-3 py-2 text-sm text-body hover:bg-sunken hover:text-ink"
                    >
                      {entry.data.title}
                    </a>
                  ))}
                </div>
              </details>
            </li>
          ) : (
            <li>
              <a href={link.href} class="mobile-link" aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
    <div class="shell mt-8 grid gap-3">
      <button type="button" class="btn btn-ghost hidden w-full" data-pwa-install>
        <Icon name="download" class="size-4" />
        Install Aplikasi DRTRANS
      </button>
      <a class="btn btn-accent w-full" href={siteConfig.action.href} target="_blank" rel="noopener">
        <Icon name="social-whatsapp" class="size-4" />
        {siteConfig.action.label}
      </a>
    </div>
  </dialog>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const syncScrolled = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  syncScrolled();
  window.addEventListener('scroll', syncScrolled, { passive: true });

  const menu = document.getElementById('mobile-nav') as HTMLDialogElement | null;

  if (menu && !('command' in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>('[commandfor="mobile-nav"]').forEach((button) => {
      button.addEventListener('click', () =>
        button.getAttribute('command') === 'close' ? menu.close() : menu.showModal(),
      );
    });
  }

  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.close();
  });
  matchMedia('(min-width: 48rem)').addEventListener('change', (event) => event.matches && menu?.close());

  const megaRoot = document.querySelector<HTMLElement>('[data-mega-root]');
  const megaTrigger = document.querySelector<HTMLButtonElement>('[data-mega-trigger]');
  const megaPanel = document.querySelector<HTMLElement>('[data-mega-panel]');

  if (megaRoot && megaTrigger && megaPanel) {
    let closeTimer: number | undefined;

    const setMegaOpen = (open: boolean) => {
      megaTrigger.setAttribute('aria-expanded', String(open));
      megaPanel.hidden = !open;
    };

    megaTrigger.addEventListener('click', () => {
      const isOpen = megaTrigger.getAttribute('aria-expanded') === 'true';
      setMegaOpen(!isOpen);
    });

    megaRoot.addEventListener('mouseenter', () => {
      if (closeTimer) window.clearTimeout(closeTimer);
      setMegaOpen(true);
    });

    megaRoot.addEventListener('mouseleave', () => {
      closeTimer = window.setTimeout(() => setMegaOpen(false), 120);
    });

    megaRoot.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMegaOpen(false);
        megaTrigger.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!megaRoot.contains(event.target as Node)) {
        setMegaOpen(false);
      }
    });

    megaPanel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMegaOpen(false));
    });
  }
</script>

<style>
  .site-header {
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .site-header[data-scrolled] {
    background-color: color-mix(in oklab, var(--canvas) 80%, transparent);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    color: var(--body);
    font-size: 0.95rem;
    font-weight: 500;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .nav-link:hover,
  .nav-link[aria-current],
  .nav-link[aria-expanded='true'] {
    color: var(--ink);
    background: var(--sunken);
  }

  .mega-panel {
    width: min(32rem, calc(100vw - 2rem));
    min-width: min(28rem, calc(100vw - 2rem));
  }

  .mega-chevron,
  .mobile-area-chevron {
    transition: transform 200ms var(--ease-out-expo);
  }

  .nav-link[aria-expanded='true'] .mega-chevron,
  .mobile-area-group[open] .mobile-area-chevron {
    transform: rotate(180deg);
  }

  .mobile-area-group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 2rem;
    border: 0;
    overflow-y: auto;
    background: var(--canvas);
    color: var(--ink);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .mobile-link[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.25em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav {
      transition:
        opacity 220ms ease,
        translate 320ms var(--ease-out-expo),
        display 320ms allow-discrete,
        overlay 320ms allow-discrete;
    }

    .mobile-nav:not([open]) {
      opacity: 0;
      translate: 0 -0.75rem;
    }

    @starting-style {
      .mobile-nav[open] {
        opacity: 0;
        translate: 0 -0.75rem;
      }
    }
  }
</style>
