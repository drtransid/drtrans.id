---
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { navigation, siteConfig } from '@/config/site';

const path = Astro.url.pathname;
const current = (href: string) =>
  path === href ? 'page' : href !== '/' && !href.startsWith('/#') && path.startsWith(href) ? 'true' : undefined;

const areaEntries = (await getCollection('area', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const stasiunEntries = areaEntries.filter((entry) => entry.data.targetLocation.toLowerCase().includes('stasiun'));
const terminalEntries = areaEntries.filter((entry) => entry.data.targetLocation.toLowerCase().includes('terminal'));
---

<header class="site-header sticky top-0 z-40 h-(--header-h) border-b border-transparent bg-canvas">
  <div class="shell relative flex h-full items-center gap-4">
    <a href="/" class="flex items-center gap-2.5 rounded-lg text-[1.15rem] font-semibold tracking-[-0.03em]">
      <Logomark />
      <span>{siteConfig.name}</span>
      <span class="sr-only">, beranda</span>
    </a>

    <nav aria-label="Main" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {navigation.map((link) =>
          link.children ? (
            <li class="relative" data-dropdown-root>
              <button
                type="button"
                class="nav-link gap-1.5"
                aria-expanded="false"
                aria-controls="layanan-submenu"
                data-dropdown-trigger
              >
                <span>{link.label}</span>
                <Icon name="chevron-down" class="dropdown-chevron size-3.5 text-muted" />
              </button>

              <div
                id="layanan-submenu"
                role="region"
                aria-label="Submenu Layanan Beranda"
                hidden
                class="submenu-panel absolute top-full left-0 z-50 mt-2 rounded-panel border border-line bg-surface p-2 shadow-card"
                data-dropdown-panel
              >
                <ul class="grid gap-0.5">
                  {link.children.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="block rounded-lg px-3 py-2 transition-colors hover:bg-sunken"
                      >
                        <span class="block text-sm font-medium text-ink">{item.label}</span>
                        {item.description && (
                          <span class="mt-0.5 block text-xs text-muted">{item.description}</span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : link.href === '/area/' ? (
            <li class="static" data-dropdown-root>
              <button
                type="button"
                class="nav-link gap-1.5"
                aria-expanded="false"
                aria-controls="area-mega-menu"
                aria-current={current('/area/')}
                data-dropdown-trigger
              >
                <span>{link.label}</span>
                <Icon name="chevron-down" class="dropdown-chevron size-3.5 text-muted" />
              </button>

              <div
                id="area-mega-menu"
                role="region"
                aria-label="Menu Area Layanan Madiun"
                hidden
                class="mega-panel absolute top-full z-50 mt-2 rounded-panel border border-line bg-surface p-4 shadow-card"
                data-dropdown-panel
              >
                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <p class="px-2.5 text-[0.7rem] font-semibold tracking-wider text-muted uppercase">
                      Stasiun Madiun
                    </p>
                    <ul class="mt-1.5 grid gap-0.5">
                      {stasiunEntries.map((entry) => {
                        const isMotor = entry.data.category.toLowerCase().includes('roda dua');
                        return (
                          <li>
                            <a
                              href={`/area/${entry.id}/`}
                              class="flex items-center justify-between gap-2 rounded-lg px-2.5 py-2 text-sm transition-colors hover:bg-sunken"
                            >
                              <span class="font-medium text-ink">
                                {isMotor ? 'Rental Motor' : 'Rental Mobil'}
                              </span>
                              <span class="text-xs text-muted">{isMotor ? 'Mulai 90K' : 'Lepas / Supir'}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>

                  <div>
                    <p class="px-2.5 text-[0.7rem] font-semibold tracking-wider text-muted uppercase">
                      Terminal Purbaya
                    </p>
                    <ul class="mt-1.5 grid gap-0.5">
                      {terminalEntries.map((entry) => {
                        const isMotor = entry.data.category.toLowerCase().includes('roda dua');
                        return (
                          <li>
                            <a
                              href={`/area/${entry.id}/`}
                              class="flex items-center justify-between gap-2 rounded-lg px-2.5 py-2 text-sm transition-colors hover:bg-sunken"
                            >
                              <span class="font-medium text-ink">
                                {isMotor ? 'Rental Motor' : 'Mobil & Hiace'}
                              </span>
                              <span class="text-xs text-muted">{isMotor ? 'Mulai 90K' : 'Rombongan'}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </div>

                <div class="mt-3 flex items-center justify-between border-t border-line px-2.5 pt-3 text-xs">
                  <span class="text-muted">Kota &amp; Kab. Madiun</span>
                  <a href="/area/" class="inline-flex items-center gap-1 font-semibold text-ink hover:text-accent-ink">
                    Semua area layanan
                    <Icon name="arrow-right" class="size-3.5" />
                  </a>
                </div>
              </div>
            </li>
          ) : (
            <li>
              <a href={link.href} class="nav-link" aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5 md:ml-2">
      <a
        class="btn btn-accent btn-sm hidden sm:inline-flex"
        href={siteConfig.action.href}
        target="_blank"
        rel="noopener"
      >
        <Icon name="social-whatsapp" class="size-3.5" />
        {siteConfig.action.label}
      </a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full hover:bg-sunken md:hidden"
        commandfor="mobile-nav"
        command="show-modal"
        aria-haspopup="dialog"
        aria-label="Menu"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <dialog id="mobile-nav" aria-label="Menu" class="mobile-nav md:hidden">
    <div class="shell flex h-(--header-h) items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 text-[1.15rem] font-semibold tracking-[-0.03em]">
        <Logomark />
        <span>{siteConfig.name}</span>
        <span class="sr-only">, beranda</span>
      </a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full hover:bg-sunken"
        commandfor="mobile-nav"
        command="close"
        aria-label="Close menu"
      >
        <Icon name="x" class="size-5" />
      </button>
    </div>
    <nav aria-label="Mobile" class="shell mt-4">
      <ul class="grid">
        <li>
          <a href="/" class="mobile-link" aria-current={path === '/' ? 'page' : undefined}>
            Beranda
          </a>
        </li>
        {navigation.map((link) =>
          link.children ? (
            <li class="border-b border-line">
              <details class="mobile-sub-group">
                <summary class="mobile-link cursor-pointer list-none justify-between border-b-0">
                  <span>{link.label}</span>
                  <Icon name="chevron-down" class="mobile-sub-chevron size-5 text-muted" />
                </summary>
                <div class="grid gap-1.5 pb-4 pl-2">
                  {link.children.map((item) => (
                    <a
                      href={item.href}
                      class="rounded-lg px-3 py-2 text-sm text-body hover:bg-sunken hover:text-ink"
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              </details>
            </li>
          ) : link.href === '/area/' ? (
            <li class="border-b border-line">
              <details class="mobile-sub-group">
                <summary class="mobile-link cursor-pointer list-none justify-between border-b-0">
                  <span>{link.label}</span>
                  <Icon name="chevron-down" class="mobile-sub-chevron size-5 text-muted" />
                </summary>
                <div class="grid gap-1.5 pb-4 pl-2">
                  <a href="/area/" class="rounded-lg px-3 py-2 text-sm font-semibold text-accent-ink hover:bg-sunken">
                    Semua Area Madiun &rarr;
                  </a>
                  {areaEntries.map((entry) => (
                    <a
                      href={`/area/${entry.id}/`}
                      class="rounded-lg px-3 py-2 text-sm text-body hover:bg-sunken hover:text-ink"
                    >
                      {entry.data.title}
                    </a>
                  ))}
                </div>
              </details>
            </li>
          ) : (
            <li>
              <a href={link.href} class="mobile-link" aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
    <div class="shell mt-8">
      <a class="btn btn-accent w-full" href={siteConfig.action.href} target="_blank" rel="noopener">
        <Icon name="social-whatsapp" class="size-4" />
        {siteConfig.action.label}
      </a>
    </div>
  </dialog>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const syncScrolled = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  syncScrolled();
  window.addEventListener('scroll', syncScrolled, { passive: true });

  const menu = document.getElementById('mobile-nav') as HTMLDialogElement | null;

  if (menu && !('command' in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>('[commandfor="mobile-nav"]').forEach((button) => {
      button.addEventListener('click', () =>
        button.getAttribute('command') === 'close' ? menu.close() : menu.showModal(),
      );
    });
  }

  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.close();
  });
  matchMedia('(min-width: 48rem)').addEventListener('change', (event) => event.matches && menu?.close());

  const dropdownRoots = Array.from(document.querySelectorAll<HTMLElement>('[data-dropdown-root]'));

  const clampPanel = (panel: HTMLElement) => {
    panel.style.translate = '';
    const rect = panel.getBoundingClientRect();
    const edge = 16;
    if (rect.left < edge) {
      panel.style.translate = `${edge - rect.left}px 0`;
    } else if (rect.right > window.innerWidth - edge) {
      panel.style.translate = `${window.innerWidth - edge - rect.right}px 0`;
    }
  };

  const setDropdown = (root: HTMLElement, open: boolean) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const panel = root.querySelector<HTMLElement>('[data-dropdown-panel]');
    if (!trigger || !panel) return;
    trigger.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (open) {
      clampPanel(panel);
    } else {
      panel.style.translate = '';
    }
  };

  const closeAllDropdowns = (except?: HTMLElement) => {
    dropdownRoots.forEach((root) => {
      if (root !== except) setDropdown(root, false);
    });
  };

  dropdownRoots.forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const panel = root.querySelector<HTMLElement>('[data-dropdown-panel]');
    if (!trigger || !panel) return;

    let closeTimer: number | undefined;

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeAllDropdowns(root);
      setDropdown(root, !isOpen);
    });

    root.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      if (closeTimer) window.clearTimeout(closeTimer);
      closeAllDropdowns(root);
      setDropdown(root, true);
    });

    root.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return;
      closeTimer = window.setTimeout(() => setDropdown(root, false), 120);
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setDropdown(root, false);
        trigger.focus();
      }
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setDropdown(root, false));
    });
  });

  document.addEventListener('click', (event) => {
    if (!dropdownRoots.some((root) => root.contains(event.target as Node))) {
      closeAllDropdowns();
    }
  });

  window.addEventListener(
    'resize',
    () => {
      dropdownRoots.forEach((root) => {
        const panel = root.querySelector<HTMLElement>('[data-dropdown-panel]');
        if (panel && !panel.hidden) clampPanel(panel);
      });
    },
    { passive: true },
  );
</script>

<style>
  .site-header {
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .site-header[data-scrolled] {
    background-color: color-mix(in oklab, var(--canvas) 80%, transparent);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    color: var(--body);
    font-size: 0.95rem;
    font-weight: 500;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .nav-link:hover,
  .nav-link[aria-current],
  .nav-link[aria-expanded='true'] {
    color: var(--ink);
    background: var(--sunken);
  }

  .submenu-panel {
    width: min(19rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - var(--header-h) - 1rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mega-panel {
    right: var(--gutter);
    width: min(32rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - var(--header-h) - 1rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .dropdown-chevron,
  .mobile-sub-chevron {
    transition: transform 200ms var(--ease-out-expo);
  }

  .nav-link[aria-expanded='true'] .dropdown-chevron,
  .mobile-sub-group[open] .mobile-sub-chevron {
    transform: rotate(180deg);
  }

  .mobile-sub-group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 2rem;
    border: 0;
    overflow-y: auto;
    background: var(--canvas);
    color: var(--ink);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .mobile-link[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.25em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav {
      transition:
        opacity 220ms ease,
        translate 320ms var(--ease-out-expo),
        display 320ms allow-discrete,
        overlay 320ms allow-discrete;
    }

    .mobile-nav:not([open]) {
      opacity: 0;
      translate: 0 -0.75rem;
    }

    @starting-style {
      .mobile-nav[open] {
        opacity: 0;
        translate: 0 -0.75rem;
      }
    }
  }
</style>
