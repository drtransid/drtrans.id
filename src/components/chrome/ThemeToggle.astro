---
import Icon from '@/components/ui/Icon.astro';
---

<div class="theme-field inline-flex items-center gap-2" data-needs-js>
  <label for="theme-select" class="text-xs font-medium text-muted">
    Tema
  </label>
  <div class="relative inline-flex items-center">
    <select
      id="theme-select"
      name="theme"
      class="theme-select min-h-10 appearance-none rounded-lg border border-line-strong bg-surface py-1.5 pr-8 pl-3 text-sm font-medium text-ink transition-colors hover:border-ink"
      data-theme-select
    >
      <option value="system" selected>Sistem</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
    <Icon name="chevron-down" class="pointer-events-none absolute right-2.5 size-4 text-muted" />
  </div>
</div>

<style>
  .theme-select {
    cursor: pointer;
  }

  .theme-select option {
    background: var(--surface);
    color: var(--ink);
  }
</style>
