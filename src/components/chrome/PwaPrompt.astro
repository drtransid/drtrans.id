---
import Icon from '@/components/ui/Icon.astro';
---

<div
  id="offline-indicator"
  role="status"
  aria-live="polite"
  hidden
  class="pointer-events-none fixed top-[calc(var(--header-h)+0.5rem)] right-3 z-30 flex items-center gap-2 rounded-full border border-line-strong bg-night px-3.5 py-1.5 text-xs font-medium text-night-ink shadow-card sm:right-5"
>
  <Icon name="wifi-off" class="size-3.5 text-accent" />
  <span>Mode Offline &mdash; Menampilkan halaman tersimpan</span>
</div>

<dialog
  id="pwa-guide-dialog"
  aria-labelledby="pwa-guide-title"
  class="m-auto w-[min(calc(100%-2rem),26rem)] rounded-card border border-line bg-surface p-6 text-ink shadow-shot backdrop:bg-black/50"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">Install Aplikasi (PWA)</p>
      <h2 id="pwa-guide-title" class="mt-3 text-title">Pasang DRTRANS di Perangkat Anda</h2>
    </div>
    <button
      type="button"
      class="grid size-9 place-items-center rounded-full hover:bg-sunken"
      data-pwa-guide-close
      aria-label="Tutup panduan instalasi"
    >
      <Icon name="x" class="size-4" />
    </button>
  </div>
  <ol class="mt-4 grid gap-3 text-sm text-body" data-pwa-guide-ios hidden>
    <li class="rounded-panel border border-line bg-sunken px-4 py-3">
      1. Ketuk tombol <strong>Bagikan (Share)</strong> pada bilah Safari.
    </li>
    <li class="rounded-panel border border-line bg-sunken px-4 py-3">
      2. Gulir ke bawah lalu pilih <strong>Tambah ke Layar Utama (Add to Home Screen)</strong>.
    </li>
    <li class="rounded-panel border border-line bg-sunken px-4 py-3">
      3. Ketuk <strong>Tambah</strong> untuk membuka DRTRANS.ID layaknya aplikasi.
    </li>
  </ol>
  <ol class="mt-4 grid gap-3 text-sm text-body" data-pwa-guide-browser>
    <li class="rounded-panel border border-line bg-sunken px-4 py-3">
      1. Buka menu browser (ikon <strong>⋮</strong> di Chrome/Android atau ikon aplikasi pada address bar desktop).
    </li>
    <li class="rounded-panel border border-line bg-sunken px-4 py-3">
      2. Pilih <strong>Install DRTRANS</strong> atau <strong>Tambahkan ke Layar Utama</strong>.
    </li>
    <li class="rounded-panel border border-line bg-sunken px-4 py-3">
      3. Konfirmasi <strong>Install</strong> untuk akses cepat ke panduan &amp; booking DRTRANS.ID.
    </li>
  </ol>
  <button type="button" class="btn btn-primary btn-sm mt-6 w-full" data-pwa-guide-close>
    Mengerti
  </button>
</dialog>

<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
  }

  interface BeforeInstallPromptEvent extends Event {
    prompt: () => Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed'; platform: string }>;
  }

  const installButtons = document.querySelectorAll<HTMLButtonElement>('[data-pwa-install]');
  const guideDialog = document.getElementById('pwa-guide-dialog') as HTMLDialogElement | null;
  const guideCloseButtons = document.querySelectorAll<HTMLButtonElement>('[data-pwa-guide-close]');
  const guideIos = document.querySelector<HTMLElement>('[data-pwa-guide-ios]');
  const guideBrowser = document.querySelector<HTMLElement>('[data-pwa-guide-browser]');
  const offlineBanner = document.getElementById('offline-indicator');

  const isStandalone = () =>
    window.matchMedia('(display-mode: standalone)').matches ||
    (window.navigator as unknown as { standalone?: boolean }).standalone === true;

  const isIOS = () =>
    /iphone|ipad|ipod/i.test(window.navigator.userAgent) &&
    !(window as unknown as { MSStream?: unknown }).MSStream;

  let deferredPrompt: BeforeInstallPromptEvent | null = null;

  const syncInstallButtons = () => {
    const installed = isStandalone();
    installButtons.forEach((btn) => {
      btn.classList.toggle('hidden', installed);
    });
  };

  syncInstallButtons();

  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    deferredPrompt = event as BeforeInstallPromptEvent;
    syncInstallButtons();
  });

  window.addEventListener('appinstalled', () => {
    deferredPrompt = null;
    syncInstallButtons();
  });

  installButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (deferredPrompt) {
        await deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          deferredPrompt = null;
        }
        syncInstallButtons();
      } else {
        const ios = isIOS();
        if (guideIos) guideIos.hidden = !ios;
        if (guideBrowser) guideBrowser.hidden = ios;
        guideDialog?.showModal();
      }
    });
  });

  guideCloseButtons.forEach((btn) => {
    btn.addEventListener('click', () => guideDialog?.close());
  });

  guideDialog?.addEventListener('click', (event) => {
    if (event.target === guideDialog) guideDialog.close();
  });

  const syncOnlineState = () => {
    if (!offlineBanner) return;
    offlineBanner.hidden = navigator.onLine;
  };

  syncOnlineState();
  window.addEventListener('online', syncOnlineState);
  window.addEventListener('offline', syncOnlineState);
</script>
