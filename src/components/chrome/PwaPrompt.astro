---
import Icon from '@/components/ui/Icon.astro';
---

<div
  id="offline-indicator"
  role="status"
  aria-live="polite"
  hidden
  class="fixed bottom-4 left-4 z-50 flex items-center gap-2.5 rounded-full border border-line-strong bg-night px-4 py-2 text-xs font-medium text-night-ink shadow-card"
>
  <Icon name="wifi-off" class="size-3.5 text-accent" />
  <span>Mode Offline &mdash; Menampilkan halaman tersimpan</span>
</div>

<dialog
  id="pwa-ios-dialog"
  aria-labelledby="pwa-ios-title"
  class="m-auto w-[min(calc(100%-2rem),26rem)] rounded-card border border-line bg-surface p-6 text-ink shadow-shot backdrop:bg-black/50"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">Install Aplikasi</p>
      <h2 id="pwa-ios-title" class="mt-3 text-title">Tambahkan DRTRANS ke Layar Utama</h2>
    </div>
    <button
      type="button"
      class="grid size-9 place-items-center rounded-full hover:bg-sunken"
      data-pwa-ios-close
      aria-label="Tutup panduan instalasi"
    >
      <Icon name="x" class="size-4" />
    </button>
  </div>
  <ol class="mt-4 grid gap-3 text-sm text-body">
    <li class="rounded-panel border border-line bg-sunken px-4 py-3">
      1. Ketuk tombol <strong>Bagikan (Share)</strong> pada bilah bawah Safari.
    </li>
    <li class="rounded-panel border border-line bg-sunken px-4 py-3">
      2. Gulir ke bawah lalu pilih <strong>Tambah ke Layar Utama (Add to Home Screen)</strong>.
    </li>
    <li class="rounded-panel border border-line bg-sunken px-4 py-3">
      3. Ketuk <strong>Tambah</strong> untuk membuka DRTRANS.ID layaknya aplikasi.
    </li>
  </ol>
  <button type="button" class="btn btn-primary btn-sm mt-6 w-full" data-pwa-ios-close>
    Mengerti
  </button>
</dialog>

<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
  }

  interface BeforeInstallPromptEvent extends Event {
    prompt: () => Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed'; platform: string }>;
  }

  const installButtons = document.querySelectorAll<HTMLButtonElement>('[data-pwa-install]');
  const iosDialog = document.getElementById('pwa-ios-dialog') as HTMLDialogElement | null;
  const iosCloseButtons = document.querySelectorAll<HTMLButtonElement>('[data-pwa-ios-close]');
  const offlineBanner = document.getElementById('offline-indicator');

  const isStandalone = () =>
    window.matchMedia('(display-mode: standalone)').matches ||
    (window.navigator as unknown as { standalone?: boolean }).standalone === true;

  const isIOS = () =>
    /iphone|ipad|ipod/i.test(window.navigator.userAgent) &&
    !(window as unknown as { MSStream?: unknown }).MSStream;

  let deferredPrompt: BeforeInstallPromptEvent | null = null;

  const syncInstallButtons = () => {
    const show = !isStandalone() && (deferredPrompt !== null || isIOS());
    installButtons.forEach((btn) => {
      btn.classList.toggle('hidden', !show);
    });
  };

  syncInstallButtons();

  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    deferredPrompt = event as BeforeInstallPromptEvent;
    syncInstallButtons();
  });

  window.addEventListener('appinstalled', () => {
    deferredPrompt = null;
    syncInstallButtons();
  });

  installButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (deferredPrompt) {
        await deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          deferredPrompt = null;
        }
        syncInstallButtons();
      } else if (isIOS()) {
        iosDialog?.showModal();
      }
    });
  });

  iosCloseButtons.forEach((btn) => {
    btn.addEventListener('click', () => iosDialog?.close());
  });

  iosDialog?.addEventListener('click', (event) => {
    if (event.target === iosDialog) iosDialog.close();
  });

  const syncOnlineState = () => {
    if (!offlineBanner) return;
    offlineBanner.hidden = navigator.onLine;
  };

  syncOnlineState();
  window.addEventListener('online', syncOnlineState);
  window.addEventListener('offline', syncOnlineState);
</script>
