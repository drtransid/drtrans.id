---
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
import { siteConfig } from '@/config/site';

const { business } = siteConfig;
---

<section class="shell pt-14 pb-20 sm:pt-20 sm:pb-28 lg:pt-24" aria-labelledby="hero-title">
  {siteConfig.availability.enabled && (
    <p class="rise inline-flex items-center gap-3 rounded-full border border-line bg-surface py-1.5 pr-4 pl-3 text-sm text-body">
      <span class="availability-dot" aria-hidden="true" />
      {siteConfig.availability.label}
    </p>
  )}

  <h1 id="hero-title" class="rise mt-8 max-w-[16ch] text-display" style="--rise-step: 1">
    {hero.title} <span class="serif">{hero.highlight}</span>
  </h1>

  <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="rise" style="--rise-step: 2">
      <p class="max-w-xl text-lead text-body">{hero.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={business.whatsapp} target="_blank" rel="noopener">
          {hero.primary.label}
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
        <a class="btn btn-ghost" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>
      <p class="mt-6 max-w-xl text-sm text-muted">
        {hero.warning}{' '}
        <a class="link font-medium text-ink" href={business.whatsapp} target="_blank" rel="noopener">
          {business.phoneDisplay}
        </a>
      </p>
    </div>

    <dl
      class="rise grid grid-cols-3 gap-6 border-t border-line pt-6 sm:gap-10 lg:border-t-0 lg:pt-0"
      style="--rise-step: 3"
    >
      {hero.facts.map((fact) => (
        <div class="flex flex-col-reverse gap-1">
          <dt class="max-w-[13ch] text-sm leading-snug text-muted">{fact.label}</dt>
          <dd class="text-section">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .availability-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
  }
</style>
