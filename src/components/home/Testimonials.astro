---
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { testimonials } from '@/config/home';
import { siteConfig } from '@/config/site';
---

<section id="ulasan" class="shell mt-28 sm:mt-36" aria-labelledby="ulasan-title">
  <SectionHead id="ulasan-title" eyebrow={testimonials.eyebrow} title={testimonials.title} text={testimonials.text}>
    <a
      class="btn btn-ghost btn-sm"
      href={siteConfig.business.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="map-pin" class="size-4 text-accent-ink" />
      Lihat di Google Maps
      <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
    </a>
  </SectionHead>

  <ul class="mt-10 grid gap-5 sm:grid-cols-3">
    {testimonials.items.map((item) => (
      <li class="reveal flex flex-col justify-between rounded-card border border-line bg-surface p-6 sm:p-7">
        <div>
          <p class="text-sm font-semibold text-accent" aria-label={`Rating ${item.rating} dari 5 bintang`}>
            {'★'.repeat(item.rating)}<span class="text-line">{'★'.repeat(5 - item.rating)}</span>
          </p>
          <blockquote class="mt-3 text-body leading-relaxed">{item.quote}</blockquote>
        </div>
        <footer class="mt-6 border-t border-line pt-4">
          <p class="text-sm font-semibold text-ink">{item.name}</p>
          <p class="mt-0.5 text-xs text-muted">{item.context}</p>
        </footer>
      </li>
    ))}
  </ul>
</section>
