---
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { services } from '@/config/home';
---

<section id="layanan" class="shell mt-28 sm:mt-36" aria-labelledby="services-title">
  <SectionHead id="services-title" eyebrow={services.eyebrow} title={services.title} />
  <ul class="mt-12 grid gap-5 sm:grid-cols-2">
    {services.items.map((item) => (
      <li class="reveal flex gap-5 rounded-card border border-line bg-surface p-7 sm:p-8">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-sunken text-accent-ink">
          <Icon name={item.icon} class="size-5" />
        </span>
        <div>
          <h3 class="text-title">{item.title}</h3>
          <p class="mt-2 text-muted">{item.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
