---
interface StatItem {
  value: string;
  label: string;
}

interface Props {
  items: StatItem[];
}

const { items } = Astro.props;
---

<dl class="not-prose grid gap-6 rounded-panel border border-line bg-sunken p-6 sm:grid-cols-3 sm:p-8">
  {items.map((item) => (
    <div class="flex flex-col-reverse gap-1">
      <dt class="text-sm text-muted">{item.label}</dt>
      <dd class="text-section text-ink">{item.value}</dd>
    </div>
  ))}
</dl>
