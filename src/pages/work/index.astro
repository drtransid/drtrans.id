---
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { workIndexSchema } from '@/lib/schema';

const entries = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const title = 'Sewa Motor & Mobil Stasiun dan Terminal Madiun';
const description =
  'Panduan lengkap rental motor mulai 75K, sewa mobil lepas kunci/driver, dan Elf Hiace dekat Stasiun Madiun dan Terminal Purboyo Madiun dari DRTRANS.ID.';
---

<BaseLayout title={title} description={description} structuredData={workIndexSchema()}>
  <PageHero
    eyebrow="Panduan area Madiun"
    title="Rental kendaraan dekat Stasiun &"
    highlight="Terminal Madiun."
    text="Layanan antar jemput gratis untuk penumpang kereta api di Stasiun Besar Madiun dan penumpang bus di Terminal Purboyo Madiun. Pilih unit motor maupun mobil sesuai kebutuhan perjalanan Anda."
  />

  <section class="shell mt-14 sm:mt-20" aria-label="Daftar panduan layanan area">
    <ul class="grid gap-6 sm:grid-cols-2">
      {entries.map((entry) => {
        const isMotor = entry.data.category.toLowerCase().includes('roda dua');
        return (
          <li class="reveal">
            <a
              href={`/work/${entry.id}/`}
              class="work-card group flex h-full flex-col justify-between rounded-card border border-line bg-surface p-7 sm:p-8"
            >
              <div>
                <div
                  class="tint-panel flex items-center justify-between gap-4 rounded-panel px-4 py-3"
                  style={`--tint: ${entry.data.tint}`}
                >
                  <span class="inline-flex items-center gap-2 text-sm font-semibold text-ink">
                    <Icon name={isMotor ? 'bike' : 'car'} class="size-4.5" />
                    {entry.data.targetLocation}
                  </span>
                  <span class="chip bg-surface/80">{entry.data.priceFrom}</span>
                </div>

                <h2 class="mt-7 text-title group-hover:underline group-hover:decoration-accent group-hover:decoration-2 group-hover:underline-offset-4">
                  {entry.data.title}
                </h2>
                <p class="mt-3 text-muted">{entry.data.description}</p>
              </div>

              <div class="mt-8 border-t border-line pt-5">
                <ul class="flex flex-wrap gap-2">
                  {entry.data.services.slice(0, 3).map((tag) => (
                    <li class="chip">{tag}</li>
                  ))}
                </ul>
                <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-ink">
                  Baca panduan lengkap
                  <Icon name="arrow-right" class="icon-nudge size-4" />
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="shell mt-16 sm:mt-24" aria-labelledby="pickup-summary-title">
    <div class="reveal rounded-card border border-line bg-sunken p-7 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
        <div>
          <p class="eyebrow">Informasi titik temu</p>
          <h2 id="pickup-summary-title" class="mt-3 text-section">
            Butuh unit cepat saat tiba di Madiun?
          </h2>
          <p class="mt-3 max-w-2xl text-body">
            Kirim jadwal kedatangan kereta di Stasiun Madiun atau bus di Terminal Purboyo melalui WhatsApp resmi{' '}
            {siteConfig.business.phoneDisplay}. Tim {siteConfig.business.legalName} siap mengantar unit dengan layanan cepat dan responsif ke lokasi Anda di area Madiun.
          </p>
        </div>
        <a
          class="btn btn-primary shrink-0"
          href={siteConfig.business.whatsapp}
          target="_blank"
          rel="noopener"
        >
          <Icon name="social-whatsapp" class="size-4" />
          Booking via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-card {
    transition:
      border-color 200ms ease,
      transform 220ms var(--ease-out-expo);
  }

  .work-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
</style>
