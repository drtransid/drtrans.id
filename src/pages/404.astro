---
import Icon from '@/components/ui/Icon.astro';
import { footerLinks } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman tidak ditemukan"
  description="Halaman yang Anda cari tidak tersedia atau telah berpindah alamat."
  noindex
  closing={false}
>
  <section class="shell grid min-h-[70vh] place-items-center py-20 text-center">
    <div>
      <p class="rise font-serif text-[clamp(6rem,4rem+10vw,12rem)] leading-none text-muted italic">404</p>
      <h1 class="rise mt-4 text-section" style="--rise-step: 1">
        Halaman tidak ditemukan.
      </h1>
      <p class="rise mx-auto mt-5 max-w-md text-lead text-muted" style="--rise-step: 2">
        Tautan mungkin sudah kedaluwarsa atau berpindah ke halaman baru. Silakan lanjutkan melalui menu di bawah ini.
      </p>
      <div class="rise mt-10 flex flex-wrap justify-center gap-3" style="--rise-step: 3">
        <a class="btn btn-primary" href="/">
          <Icon name="arrow-left" class="size-4" />
          Kembali ke Beranda
        </a>
        {footerLinks.slice(0, 4).map((link) => (
          <a class="btn btn-ghost" href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
