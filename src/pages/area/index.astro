---
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { areaIndexSchema } from '@/lib/schema';

const entries = (await getCollection('area', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const coverageZones = [
  {
    name: 'Pusat Kota & Kawasan Bisnis Madiun',
    detail: 'Area Jalan Pahlawan, Alun-Alun Madiun, pusat pemerintahan, perkantoran, dan perbankan.',
  },
  {
    name: 'Hotel, Penginapan & Homestay',
    detail: 'Pengantaran langsung ke resepsionis atau area parkir hotel dan penginapan di Kota Madiun.',
  },
  {
    name: 'Kabupaten Madiun & Kawasan Sekitar',
    detail: 'Melayani Jiwan, Mejayan/Caruban, Dolopo, Wungu, serta pengantaran lanjutan ke Maospati, Magetan, Ngawi, dan Ponorogo.',
  },
  {
    name: 'Titik Kedatangan Stasiun & Terminal',
    detail: 'Serah terima terjadwal 24 jam di area penjemputan / pintu keluar Stasiun Madiun dan Terminal Purbaya (Purboyo) Madiun.',
  },
];

const title = 'Area Layanan Rental Mobil & Rental Motor Madiun';
const description =
  'Cakupan area layanan rental mobil Madiun dan sewa motor oleh DRTRANS.ID di Kota & Kabupaten Madiun: pusat kota, hotel, kantor, Stasiun Madiun, hingga Terminal Purbaya.';
---

<BaseLayout title={title} description={description} structuredData={areaIndexSchema()}>
  <PageHero
    eyebrow="Cakupan area Madiun Raya"
    title="Area layanan rental mobil & sewa motor di"
    highlight="Kota dan Kabupaten Madiun."
    text="PT. AZZAHRA JAYA TRANSPORTATION melayani pengantaran dan penjemputan kendaraan ke seluruh wilayah strategis Madiun — mulai dari pusat kota, hotel, kawasan bisnis, perumahan, rute sekitar Magetan–Ponorogo–Ngawi, hingga titik kedatangan utama di Stasiun Madiun dan Terminal Purbaya (Purboyo)."
  />

  <section class="shell mt-14 sm:mt-20" aria-labelledby="zones-title">
    <SectionHead
      id="zones-title"
      eyebrow="Wilayah operasional"
      title="Menjangkau pusat kota hingga titik kedatangan utama"
      text="Pilih titik serah terima yang paling praktis untuk agenda kerja, kunjungan keluarga, maupun liburan Anda di Madiun."
    />
    <ul class="mt-10 grid gap-5 sm:grid-cols-2">
      {coverageZones.map((zone) => (
        <li class="reveal rounded-card border border-line bg-surface p-6 sm:p-7">
          <div class="flex items-center gap-2.5 text-base font-semibold text-ink">
            <Icon name="map-pin" class="size-4.5 text-accent-ink" />
            <h3>{zone.name}</h3>
          </div>
          <p class="mt-2.5 text-sm leading-relaxed text-muted">{zone.detail}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="shell mt-20 sm:mt-24" aria-labelledby="hubs-title">
    <SectionHead
      id="hubs-title"
      eyebrow="Panduan titik kedatangan"
      title="Layanan antar jemput Stasiun Madiun & Terminal Purbaya"
      text="Selain area pusat kota dan penginapan, berikut panduan khusus untuk penumpang kereta api di Stasiun Madiun serta bus di Terminal Purbaya (Purboyo) Madiun."
    />
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      {entries.map((entry) => {
        const isMotor = entry.data.category.toLowerCase().includes('roda dua');
        return (
          <li class="reveal">
            <a
              href={`/area/${entry.id}/`}
              class="area-card group flex h-full flex-col justify-between rounded-card border border-line bg-surface p-7 sm:p-8"
            >
              <div>
                <div
                  class="tint-panel flex items-center justify-between gap-4 rounded-panel px-4 py-3"
                  style={`--tint: ${entry.data.tint}`}
                >
                  <span class="inline-flex items-center gap-2 text-sm font-semibold text-ink">
                    <Icon name={isMotor ? 'bike' : 'car'} class="size-4.5" />
                    {entry.data.targetLocation}
                  </span>
                  <span class="chip bg-surface/80">{entry.data.priceFrom}</span>
                </div>

                <h3 class="mt-7 text-title group-hover:underline group-hover:decoration-accent group-hover:decoration-2 group-hover:underline-offset-4">
                  {entry.data.title}
                </h3>
                <p class="mt-3 text-muted">{entry.data.description}</p>
              </div>

              <div class="mt-8 border-t border-line pt-5">
                <ul class="flex flex-wrap gap-2">
                  {entry.data.services.slice(0, 3).map((tag) => (
                    <li class="chip">{tag}</li>
                  ))}
                </ul>
                <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-ink">
                  Lihat detail layanan &amp; syarat
                  <Icon name="arrow-right" class="icon-nudge size-4" />
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="shell mt-16 sm:mt-24" aria-labelledby="pickup-summary-title">
    <div class="reveal rounded-card border border-line bg-sunken p-7 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
        <div>
          <p class="eyebrow">Informasi pengantaran &amp; pembayaran</p>
          <h2 id="pickup-summary-title" class="mt-3 text-section">
            Butuh antar unit langsung ke lokasi Anda di Madiun?
          </h2>
          <p class="mt-3 max-w-2xl text-body">
            Kirimkan alamat pengantaran (hotel, kantor, rumah, area penjemputan Stasiun Madiun, atau Terminal Purbaya) ke WhatsApp resmi{' '}
            {siteConfig.business.phoneDisplay}. Pembayaran resmi {siteConfig.business.legalName} hanya melalui rekening BCA dan BRI.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            class="btn btn-primary shrink-0"
            href={siteConfig.business.whatsapp}
            target="_blank"
            rel="noopener"
          >
            <Icon name="social-whatsapp" class="size-4" />
            Booking via WhatsApp
          </a>
          <a
            class="btn btn-ghost shrink-0"
            href={siteConfig.business.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="map-pin" class="size-4 text-accent-ink" />
            Lokasi Google Maps
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .area-card {
    transition:
      border-color 200ms ease,
      transform 220ms var(--ease-out-expo);
  }

  .area-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
</style>
