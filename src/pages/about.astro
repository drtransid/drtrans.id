---
import Icon from '@/components/ui/Icon.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { about } from '@/config/about';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { aboutPageSchema } from '@/lib/schema';

const { business } = siteConfig;
---

<BaseLayout
  title={about.seo.title}
  description={about.seo.description}
  structuredData={aboutPageSchema()}
>
  <PageHero
    eyebrow={about.hero.eyebrow}
    title={about.hero.title}
    highlight={about.hero.highlight}
    text={about.hero.text}
  >
    <div class="rise mt-8 flex flex-wrap gap-3" style="--rise-step: 3">
      <a class="btn btn-primary" href={business.whatsapp} target="_blank" rel="noopener">
        <Icon name="social-whatsapp" class="size-4" />
        Hubungi via WhatsApp
      </a>
      <a class="btn btn-ghost" href="/area/">
        Lihat Cakupan Area Madiun
        <Icon name="arrow-right" class="icon-nudge size-4" />
      </a>
    </div>
  </PageHero>

  <section class="shell mt-14 sm:mt-20" aria-label="Ringkasan layanan">
    <dl class="reveal grid gap-6 border-y border-line py-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10">
      {about.stats.map((item) => (
        <div class="flex flex-col-reverse gap-1.5">
          <dt class="text-sm text-muted">{item.label}</dt>
          <dd class="text-section">{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="shell mt-20 sm:mt-28" aria-label="Profil dan standar DRTRANS.ID">
    <div class="grid gap-16 sm:gap-24">
      {about.sections.map((section) => (
        <article class="reveal grid gap-8 border-t border-line pt-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="eyebrow">{section.eyebrow}</p>
            <h2 class="mt-4 text-section">{section.title}</h2>
          </div>
          <div class="grid gap-6 text-lead text-body">
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="shell mt-24 sm:mt-32" aria-labelledby="principles-title">
    <SectionHead
      id="principles-title"
      eyebrow={about.principles.eyebrow}
      title={about.principles.title}
    />
    <ol class="mt-12 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2">
      {about.principles.items.map((item) => (
        <li class="reveal flex flex-col justify-between bg-surface p-7 sm:p-9">
          <span class="font-serif text-3xl text-accent-ink italic">{item.number}</span>
          <div class="mt-10">
            <h3 class="text-title">{item.title}</h3>
            <p class="mt-3 text-muted">{item.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="shell mt-24 sm:mt-32" aria-labelledby="coverage-title">
    <div class="reveal rounded-card border border-line bg-sunken p-7 sm:p-10 lg:p-12">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start">
        <div>
          <p class="eyebrow">{about.coverage.eyebrow}</p>
          <h2 id="coverage-title" class="mt-4 text-section">{about.coverage.title}</h2>
          <p class="mt-4 text-body">{about.coverage.text}</p>
          <p class="mt-6 text-sm font-medium text-ink">
            Entitas Resmi: {business.legalName}
          </p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {about.coverage.points.map((point) => (
            <li class="rounded-panel border border-line bg-surface p-5">
              <div class="flex items-center gap-2 text-base font-semibold text-ink">
                <Icon name="map-pin" class="size-4 text-accent-ink" />
                {point.label}
              </div>
              <p class="mt-2 text-sm text-muted">{point.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
